# Ranar's Prophecy environment configuration
# Do not commit real credentials or private IP addresses.

# Port is optional. A platform-provided PORT takes precedence.
PORT=3000

# Tank access keys
tankkey1=
tankkey2=
tankkey3=

# Developer IP allowlist entries
kris2=
kris3=
JJ3=
jj2=

# Developer command passwords
ranar=
jj=
kris=

# Load protection thresholds (all optional; milliseconds per simulation cycle / event-loop p95).
# Start reducing optional work around 75 ms, increase mitigation around 150 ms,
# and start sequential high-cost entity suspension around 250 ms.
# Simulation cadence also slows progressively with lag. Defaults: 1.15x at 75ms,
# 1.30x at 100ms, 1.50x at 150ms, 1.75x at 200ms, and 2.00x at 250ms.
# A 2.00x factor halves the target tick rate. During an overlong tick, the scheduler
# adds a proportional idle gap, so it does not immediately catch up in a burst.
# Run speed returns one tier toward normal after 10 consecutive healthy cycles.
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_75=1.15
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_100=1.3
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_150=1.5
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_200=1.75
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_250=2
# RANAR_LOAD_WARNING_DELAY_MS=75
# RANAR_LOAD_HIGH_DELAY_MS=150
# RANAR_LOAD_CRITICAL_DELAY_MS=250

# Emergency entity suspension cadence and visual transition duration (milliseconds).
# At >=250ms lag, suspend one eligible entity immediately and another every 2.5s.
# If lag never falls below 250ms for 60s, restore critical-suspended entities and
# block further critical suspensions until lag falls below 250ms.
# Each fade-out and fade-in lasts 2.5s by default.
# RANAR_LOAD_SUSPEND_INTERVAL_MS=2500
# RANAR_LOAD_SUSPEND_WINDOW_MS=60000
# RANAR_LOAD_ENTITY_FADE_MS=2500

# Sustained-lag contingencies; thresholds require continuous time above the value.
# At 100ms for 10s: pause recurring natural/bot/entity spawning and food, and destroy
# unprotected entities labeled/named exactly "Unknown Entity" or "Unknown Class". Resume after 10s below 100ms.
# At 150ms for 15s: destroy tagged naturally spawned entities that are off-screen.
# At 200ms for 15s: destroy all projectiles and tagged naturally spawned entities on-screen.
# Cleanup repeats every 2.5s while the corresponding lag condition persists.
# One-time map structures (maze walls, gates, portals, etc.) are not tagged as natural.
# RANAR_LAG_100_DURATION_MS=10000
# RANAR_LAG_150_DURATION_MS=15000
# RANAR_LAG_200_DURATION_MS=15000
# RANAR_LAG_CLEANUP_INTERVAL_MS=2500
# Maximum entity slots inspected per simulation cycle during sustained-lag cleanup.
# RANAR_LAG_CLEANUP_BATCH_SIZE=32
# RANAR_LAG_POLICY_RECOVERY_MS=10000
