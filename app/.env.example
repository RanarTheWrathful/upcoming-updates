# Ranar's Prophecy environment configuration
# Do not commit real credentials or private IP addresses.

# Port is optional. A platform-provided PORT takes precedence.
PORT=3000

# Tank access keys
tankkey1=
tankkey2=
tankkey3=

# Developer IP allowlist entries
kris2=
kris3=
JJ3=
jj2=

# Developer command passwords
ranar=
jj=
kris=

# Load protection thresholds (all optional; milliseconds per simulation cycle/event-loop p95).
# Ordinary pressure scales up over time. Defaults: 1.05x at 75ms, 1.10x at
# 100ms, 1.15x at 150ms, 1.25x at 200ms, and 1.35x at 250ms. Pacing rises one
# level at a time after sustained pressure and returns one level after 5s of
# stable recovery. Only >=500ms latency skips directly to the maximum response.
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_75=1.05
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_100=1.1
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_150=1.15
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_200=1.25
# RANAR_LOAD_RUN_SPEED_MULTIPLIER_250=1.35
# RANAR_LOAD_WARNING_DELAY_MS=75
# RANAR_LOAD_HIGH_DELAY_MS=150
# RANAR_LOAD_CRITICAL_DELAY_MS=250
# RANAR_LOAD_EXTREME_DELAY_MS=500
# RANAR_LOAD_STAGE_ESCALATION_MS=1500
# RANAR_LOAD_HIGH_STAGE_ESCALATION_MS=3000
# RANAR_LOAD_CRITICAL_STAGE_ESCALATION_MS=6000
# RANAR_LOAD_STAGE_RECOVERY_MS=5000
# RANAR_LOAD_RUN_SPEED_ESCALATION_MS=1250
# RANAR_LOAD_RUN_SPEED_RECOVERY_MS=5000

# Critical entity suspension requires >=500ms lag sustained for 15s by default.
# Once triggered, one high-cost eligible entity fades out at a time, with a new
# entity selected every 2.5s. Restorations also start one at a time, by default
# every 2.5s, with each fade-out/fade-in taking 2.5s. After a 60s
# suspension episode, the system restores entities and locks out further
# suspension until latency recovers below 80% of the emergency threshold.
# RANAR_LOAD_CRITICAL_SUSPEND_DELAY_MS=500
# RANAR_LAG_CRITICAL_DURATION_MS=15000
# RANAR_LOAD_SUSPEND_INTERVAL_MS=2500
# RANAR_LOAD_RESTORE_INTERVAL_MS=2500
# RANAR_LOAD_SUSPEND_WINDOW_MS=60000
# RANAR_LOAD_ENTITY_FADE_MS=2500

# Sustained-lag contingencies, all processed incrementally.
# At >=100ms for 10s: pause recurring natural/bot/entity spawning and food.
# Spawning resumes after 10s below 80ms (hysteresis avoids threshold flapping).
# At >=200ms for 20s: destroy tagged naturally spawned entities that are off-screen.
# At >=300ms for 20s: incrementally sweep unknown-class entities.
# At >=350ms for 25s: destroy projectiles and tagged natural entities on-screen.
# Small dips do not rearm a triggered policy; destructive sweeps cancel if the
# server genuinely recovers before they finish. Protected walls, gates, bosses,
# players, and KEEP entities are excluded from the cleanup targets.
# RANAR_LAG_100_DURATION_MS=10000
# RANAR_LAG_OFFSCREEN_THRESHOLD_MS=200
# RANAR_LAG_150_DURATION_MS=20000
# RANAR_LAG_UNKNOWN_THRESHOLD_MS=300
# RANAR_LAG_UNKNOWN_DURATION_MS=20000
# RANAR_LAG_ONSCREEN_THRESHOLD_MS=350
# RANAR_LAG_200_DURATION_MS=25000
# RANAR_LAG_CLEANUP_INTERVAL_MS=2500
# Maximum entity slots inspected per simulation cycle during sustained-lag cleanup.
# RANAR_LAG_CLEANUP_BATCH_SIZE=2
# RANAR_LAG_POLICY_RECOVERY_MS=10000
